LLM_API_KEY=
LLM_BASE_URL=https://chat.ecnu.edu.cn/open/api/v1
LLM_MODEL=ecnu-plus
LLM_TIMEOUT=20
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=1024
LLM_RETRIES=2

# Sentiment backend: auto, bert, tfidf, or rule
SENTIMENT_BACKEND=auto
BERT_MODEL_PATH=outputs/bert_model_final
BERT_DEVICE=auto
BERT_BATCH_SIZE=32
BERT_MAX_LENGTH=160
BERT_STRIDE=32
BERT_MAX_CHUNKS=16
